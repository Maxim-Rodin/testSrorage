<Window x:Class="testSrorage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Складская система" Height="500" Width="900"
        Background="#F5F5F5">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

       
        <TextBlock Text="Система учета склада"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="5"/>

       
        <Border Grid.Row="1" Background="White" CornerRadius="5" Padding="5" Margin="0,10,0,10">
            <DataGrid x:Name="datagrid"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"/>
        </Border>

       
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

           
            <StackPanel Grid.Column="0" Margin="5">
                <TextBlock Text="Приходы" FontWeight="Bold" Margin="0,0,0,5"/>
                <Button Content="Просмотр приходов" Height="35" Margin="0,2" Click="checkArriveBtn_Click"/>
                <Button Content="Добавить приход" Height="35" Margin="0,2" Click="arrivalBtn_Click"/>
                <Button Content="Фильтр приходов" Height="35" Margin="0,2" Click="arriveDataBtn_Click"/>
            </StackPanel>

            
            <StackPanel Grid.Column="1" Margin="5">
                <TextBlock Text="Товары" FontWeight="Bold" Margin="0,0,0,5"/>
                <Button Content="Просмотр продуктов" Height="35" Margin="0,2" Click="checkBtn1_Click"/>
                <Button Content="Изменить" Height="35" Margin="0,2" Click="changeBtn_Click"/>
                <Button Content="Удалить" Height="35" Margin="0,2" Click="deletBtn_Click"/>
            </StackPanel>

            
            <StackPanel Grid.Column="2" Margin="5">
                <TextBlock Text="Расходы" FontWeight="Bold" Margin="0,0,0,5"/>
                <Button Content="Посмотреть расходы" Height="35" Margin="0,2" Click="checkExpensesBtn_Click"/>
                <Button Content="Добавить расход" Height="35" Margin="0,2" Click="addExpenesBtn_Click"/>
                <Button Content="Фильтр расходов" Height="35" Margin="0,2" Click="expensesDataBtn_Click"/>
                <Button Content="Проверить соединение" Height="35" Margin="0,10,0,0" Click="Button_Click"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>