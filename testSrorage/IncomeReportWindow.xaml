<Window x:Class="testSrorage.IncomeReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:testSrorage"
        mc:Ignorable="d"
        Title="IncomeReportWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Отчет по приходам" 
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Параметры отчета -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
            <StackPanel>
                <TextBlock Text="Выберите период:" FontWeight="Bold" Margin="0,0,0,5"/>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="С:" VerticalAlignment="Center" Width="30"/>
                    <DatePicker x:Name="dpStartDate" Width="150" Margin="5,0"/>

                    <TextBlock Text="По:" VerticalAlignment="Center" Width="30" Margin="20,0,0,0"/>
                    <DatePicker x:Name="dpEndDate" Width="150" Margin="5,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <Button x:Name="btnGenerateReport" Content="Сформировать отчет" 
                            Click="btnGenerateReport_Click" Width="150"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Результаты отчета -->
        <DataGrid x:Name="dgReport" Grid.Row="2" Margin="0,10,0,0" 
                  AutoGenerateColumns="True" IsReadOnly="True"/>

        <!-- Итоги -->
        <Border Grid.Row="3" BorderBrush="LightGray" BorderThickness="1" 
                CornerRadius="5" Padding="10" Margin="0,10,0,0" Background="LightYellow">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="txtSummary" FontWeight="Bold"/>
                <TextBlock x:Name="txtTotalQuantity" Margin="20,0,0,0" FontWeight="Bold" Foreground="Green"/>
                <TextBlock x:Name="txtTotalCount" Margin="20,0,0,0" FontWeight="Bold" Foreground="Blue"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
