<Window x:Class="testSrorage.AddExpensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:testSrorage"
        mc:Ignorable="d"
        Title="AddExpensesWindow" Height="450" Width="800">
    <Grid>
        <Label x:Name="nameLbl" Content="Введите название:" HorizontalAlignment="Left" Margin="181,66,0,0" VerticalAlignment="Top" Width="120" Height="43"/>
        <TextBox x:Name="nameTxBx" HorizontalAlignment="Left" Margin="327,70,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="151"/>
        <Label x:Name="quantityLbl" Content="Введите колличество :" HorizontalAlignment="Left" Margin="166,163,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.053,1.157" Width="135" Height="26"/>
        <TextBox x:Name="quantityTxBx" HorizontalAlignment="Left" Margin="327,167,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="151"/>
        <Label x:Name="dateLbl" Content="Дата прихода :" HorizontalAlignment="Left" Margin="212,259,0,0" VerticalAlignment="Top" Width="110"/>
        <DatePicker x:Name="dataPiker" HorizontalAlignment="Left" Margin="327,261,0,0" VerticalAlignment="Top"/>
        <Button x:Name="aplyBtn" Content="Применить" HorizontalAlignment="Left" Margin="471,351,0,0" VerticalAlignment="Top" Height="49" Width="108" IsCancel="True" Click="aplyBtn_Click"/>
        <Button x:Name="canсelBtn" Content="Отменить" HorizontalAlignment="Left" Margin="166,355,0,0" VerticalAlignment="Top" Height="45" Width="108" Click="canсelBtn_Click"/>

    </Grid>
</Window>
